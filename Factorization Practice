      const today = new Date().toISOString().split('T')[0];
      const subDate = document.getElementById('submissionDate');
      if (subDate) subDate.value = today;
    };

    function renderKaTeX(elementId, latexStr) {
      const el = document.getElementById(elementId);
      if (el && window.katex) {
        try {
          katex.render(latexStr, el, { throwOnError: false });
        } catch (e) {
          el.innerText = latexStr;
        }
      }
    }

    function initTimer() {
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        timerSeconds++;
        updateTimerDisplay();
      }, 1000);
    }

    function updateTimerDisplay() {
      const display = document.getElementById('timerDisplay');
      if (display) {
        display.innerText = formatTime(timerSeconds);
      }
    }

    function formatTime(sec) {
      const m = Math.floor(sec / 60).toString().padStart(2, '0');
      const s = (sec % 60).toString().padStart(2, '0');
      return `${m}:${s}`;
    }

    window.setFilter = function(filterType) {
      currentFilter = filterType;
      document.querySelectorAll('.filter-tab').forEach(btn => {
        btn.className = 'filter-tab px-3 py-1.5 rounded-xl text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800 transition';
      });

      const activeBtn = document.getElementById(`filter-${filterType}`);
      if (activeBtn) {
        activeBtn.className = 'filter-tab px-3 py-1.5 rounded-xl text-xs font-semibold bg-indigo-600 text-white transition';
      }

      renderQuestions();
    };

    window.jumpToQuestion = function(qId) {
      const num = parseInt(qId, 10);
      const card = document.getElementById(`card-${num}`);
      if (card) {
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        setActiveInput(num);
      }
    };

    function populateJumpSelect() {
      const select = document.getElementById('jumpSelect');
      if (!select) return;
      select.innerHTML = '';
      questionsData.forEach(q => {
        const opt = document.createElement('option');
        opt.value = q.id;
        opt.innerText = `Q#${q.displayNum}`;
        select.appendChild(opt);
      });
    }

    function renderQuestions() {
      const container = document.getElementById('questionsContainer');
      if (!container) return;
      container.innerHTML = '';

      const filtered = questionsData.filter(q => {
        const status = checkStatus[q.id] || 'unattempted';
        if (currentFilter === 'level1') return q.level === 1;
        if (currentFilter === 'level2') return q.level === 2;
        if (currentFilter === 'attempted') return status !== 'unattempted';
        if (currentFilter === 'unanswered') return status === 'unattempted';
        return true;
