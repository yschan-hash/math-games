                <span class="text-[11px]">${isTeacherUnlocked ? 'Solution' : 'Protected'}</span>
              </button>
            </div>

            <!-- Problem Expression -->
            <div class="bg-slate-900/80 p-3.5 rounded-xl border border-slate-800/80 mb-4 overflow-x-auto min-h-[50px] flex items-center justify-between">
              <div id="katex-expr-${q.id}" class="text-base sm:text-lg text-slate-100 font-medium"></div>
              ${statusIcon}
            </div>

            <!-- Target Solution Box (Hidden until password verified) -->
            <div id="solutionBox-${q.id}" class="hidden mb-4 bg-amber-950/20 border border-amber-500/30 rounded-xl p-3 text-xs">
