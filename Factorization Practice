<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Factorization Practice Worksheet (50 Questions)</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#eef2ff',
              100: '#e0e7ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
            }
          }
        }
      }
    }
  </script>

  <!-- KaTeX CSS & JS for LaTeX Math Rendering -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css">
  <script src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js"></script>

  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #0f172a;
    }
    ::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #475569;
    }

    /* Print Stylesheet */
    @media print {
      body {
        background-color: #ffffff !important;
        color: #000000 !important;
      }
      .no-print {
        display: none !important;
      }
      .print-only {
        display: block !important;
      }
      .page-break {
        page-break-before: always;
      }
      .card-box {
        border: 1px solid #cbd5e1 !important;
        background: #ffffff !important;
        box-shadow: none !important;
        break-inside: avoid;
      }
    }

    .print-only {
      display: none;
    }

    /* Keypad Ripple Effect */
    .key-btn {
      transition: all 0.1s ease;
      touch-action: manipulation;
    }
    .key-btn:active {
      transform: scale(0.93);
    }
  </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col font-sans selection:bg-indigo-500 selection:text-white pb-36">

  <!-- ================= HEADER & LIVE DASHBOARD ================= -->
  <header class="no-print sticky top-0 z-30 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 shadow-xl">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        
        <!-- Left: Title & Timer -->
        <div class="flex items-center justify-between md:justify-start gap-4">
          <div>
            <h1 class="text-xl sm:text-2xl font-bold bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">
              Factorization Practice Worksheet
            </h1>
            <p class="text-xs text-slate-400">50 Questions (55 Parts) • Secondary School Curriculum</p>
          </div>
          <div class="flex items-center gap-2 bg-slate-800 px-3 py-1.5 rounded-xl border border-slate-700 text-xs text-slate-300">
            <i class="fa-regular font-mono text-indigo-400 fa-clock"></i>
            <span id="timerDisplay" class="font-mono font-bold text-slate-200">00:00</span>
          </div>
        </div>

        <!-- Right: Requirements Badge & Action Buttons -->
        <div class="flex items-center justify-between sm:justify-end gap-3 flex-wrap">
          <!-- Requirement Status Badge -->
          <div id="requirementBadge" class="flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/30">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span id="reqText">Requirement: 0/30 Answered</span>
          </div>

          <!-- Teacher Mode Password Unlock Button -->
          <button id="teacherUnlockBtn" onclick="openPasswordModal()" class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-medium text-amber-400 transition">
            <i class="fa-solid fa-lock"></i>
            <span id="teacherBtnText" class="hidden sm:inline">Teacher Mode</span>
          </button>

          <!-- Keypad Toggle -->
          <button id="toggleKeypadBtn" onclick="toggleVirtualKeyboard()" class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-medium text-slate-200 transition">
            <i class="fa-solid fa-keyboard text-indigo-400"></i>
            <span class="hidden sm:inline">Keypad</span>
          </button>

          <!-- Submit Button -->
          <button id="submitWorksheetBtn" onclick="openSubmitModal()" class="flex items-center gap-2 px-4 py-1.5 rounded-xl bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white font-semibold text-xs shadow-lg shadow-indigo-600/30 transition disabled:opacity-50 disabled:cursor-not-allowed">
            <i class="fa-solid fa-paper-plane"></i>
            <span>Finish & Submit</span>
          </button>
        </div>
      </div>

      <!-- Dashboard Progress Bar & Stats -->
      <div class="mt-3 pt-3 border-t border-slate-800/80 grid grid-cols-2 sm:grid-cols-5 gap-3 items-center text-xs">
        
        <!-- Progress Bar Container -->
        <div class="col-span-2 sm:col-span-2">
          <div class="flex justify-between items-center mb-1 text-slate-400 font-medium">
            <span>Overall Progress</span>
            <span id="progressPercent" class="text-indigo-400 font-bold">0% (0/55)</span>
          </div>
          <div class="w-full bg-slate-800 rounded-full h-2.5 overflow-hidden border border-slate-700/50">
            <div id="progressBar" class="bg-gradient-to-r from-indigo-500 to-purple-500 h-2.5 rounded-full transition-all duration-300" style="width: 0%"></div>
          </div>
        </div>

        <!-- Correct Count -->
        <div class="bg-slate-800/60 border border-slate-800 p-2 rounded-xl flex items-center justify-between">
          <span class="text-slate-400">Correct:</span>
          <span id="correctCount" class="font-bold text-emerald-400">0</span>
        </div>

        <!-- Incorrect Count -->
        <div class="bg-slate-800/60 border border-slate-800 p-2 rounded-xl flex items-center justify-between">
          <span class="text-slate-400">Incorrect:</span>
          <span id="incorrectCount" class="font-bold text-rose-400">0</span>
        </div>

        <!-- Completion Score -->
        <div class="bg-slate-800/60 border border-slate-800 p-2 rounded-xl flex items-center justify-between">
          <span class="text-slate-400">Accuracy:</span>
          <span id="accuracyScore" class="font-bold text-indigo-300">0%</span>
        </div>
      </div>
    </div>
  </header>

  <!-- ================= MAIN CONTENT CONTAINER ================= -->
  <main class="no-print max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full">
    
    <!-- Filter & Navigation Toolbar -->
    <div class="bg-slate-800/40 border border-slate-800 rounded-2xl p-4 mb-6 flex flex-col md:flex-row gap-4 items-center justify-between">
      
      <!-- Filter Tabs -->
      <div class="flex items-center gap-1.5 flex-wrap w-full md:w-auto">
        <button onclick="setFilter('all')" id="filter-all" class="filter-tab px-3 py-1.5 rounded-xl text-xs font-semibold bg-indigo-600 text-white transition">
          All (55)
        </button>
        <button onclick="setFilter('level1')" id="filter-level1" class="filter-tab px-3 py-1.5 rounded-xl text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800 transition">
          Level 1 (Easy)
        </button>
        <button onclick="setFilter('level2')" id="filter-level2" class="filter-tab px-3 py-1.5 rounded-xl text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800 transition">
          Level 2 (Medium)
        </button>
        <button onclick="setFilter('attempted')" id="filter-attempted" class="filter-tab px-3 py-1.5 rounded-xl text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800 transition">
          Attempted
        </button>
        <button onclick="setFilter('unanswered')" id="filter-unanswered" class="filter-tab px-3 py-1.5 rounded-xl text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800 transition">
          Unanswered
        </button>
      </div>

      <!-- Quick Question Jump & Reset -->
      <div class="flex items-center gap-3 w-full md:w-auto justify-between md:justify-end">
        <div class="flex items-center gap-2">
          <label for="jumpSelect" class="text-xs text-slate-400">Jump to:</label>
          <select id="jumpSelect" onchange="jumpToQuestion(this.value)" class="bg-slate-900 border border-slate-700 text-xs text-slate-200 rounded-xl px-2.5 py-1.5 focus:outline-none focus:border-indigo-500">
            <!-- Populated via JS -->
          </select>
        </div>

        <button onclick="confirmResetAll()" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-rose-950/50 text-slate-400 hover:text-rose-400 border border-slate-700 hover:border-rose-800 text-xs transition">
          <i class="fa-solid fa-rotate-right mr-1"></i> Reset
        </button>
      </div>
    </div>

    <!-- Questions Grid Container -->
    <div id="questionsContainer" class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Question Cards dynamically injected here -->
    </div>
  </main>

  <!-- ================= FLOATING ON-SCREEN MATH KEYBOARD ================= -->
  <div id="virtualKeypad" class="no-print fixed bottom-0 left-0 right-0 z-40 bg-slate-900/95 border-t border-slate-700 shadow-2xl backdrop-blur-lg transform transition-transform duration-300">
    <div class="max-w-4xl mx-auto px-3 py-2">
      
      <!-- Keypad Header Bar -->
      <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-800 text-xs">
        <div class="flex items-center gap-2">
          <span class="font-bold text-indigo-400"><i class="fa-solid fa-keyboard mr-1"></i> Math Keypad</span>
          <span id="activeQuestionTarget" class="text-slate-400 bg-slate-800 px-2 py-0.5 rounded-md text-[10px]">Select an input field</span>
        </div>
        <div class="flex items-center gap-2">
          <button onclick="clearActiveInput()" class="text-slate-400 hover:text-rose-400 px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-[11px] transition">Clear</button>
          <button onclick="toggleVirtualKeyboard()" class="text-slate-400 hover:text-white px-2 py-0.5 rounded bg-slate-800 text-[11px]"><i class="fa-solid fa-chevron-down"></i></button>
        </div>
      </div>

      <!-- Keypad Button Rows -->
      <div class="grid grid-cols-12 gap-1 text-center font-mono">
        
        <!-- Row 1: Exponents, Parentheses, Operations -->
        <button onclick="keyInsert('^2')" class="key-btn col-span-2 bg-slate-800 hover:bg-indigo-600 text-indigo-300 hover:text-white p-2 rounded-lg text-xs font-bold border border-slate-700">x²</button>
        <button onclick="keyInsert('^3')" class="key-btn col-span-2 bg-slate-800 hover:bg-indigo-600 text-indigo-300 hover:text-white p-2 rounded-lg text-xs font-bold border border-slate-700">x³</button>
        <button onclick="keyInsert('^')" class="key-btn col-span-2 bg-slate-800 hover:bg-indigo-600 text-indigo-300 hover:text-white p-2 rounded-lg text-xs font-bold border border-slate-700">xⁿ (^)</button>
        <button onclick="keyInsert('(')" class="key-btn col-span-2 bg-slate-800 hover:bg-slate-700 text-slate-200 p-2 rounded-lg text-sm font-bold border border-slate-700">(</button>
        <button onclick="keyInsert(')')" class="key-btn col-span-2 bg-slate-800 hover:bg-slate-700 text-slate-200 p-2 rounded-lg text-sm font-bold border border-slate-700">)</button>
        <button onclick="keyBackspace()" class="key-btn col-span-2 bg-rose-950/60 hover:bg-rose-600 text-rose-300 hover:text-white p-2 rounded-lg text-xs font-bold border border-rose-800/50"><i class="fa-solid fa-backspace"></i></button>

        <!-- Row 2: Variable Keys -->
        <button onclick="keyInsert('x')" class="key-btn col-span-1 bg-slate-800 hover:bg-slate-700 text-amber-300 p-2 rounded-lg text-xs font-bold border border-slate-700">x</button>
        <button onclick="keyInsert('y')" class="key-btn col-span-1 bg-slate-800 hover:bg-slate-700 text-amber-300 p-2 rounded-lg text-xs font-bold border border-slate-700">y</button>
        <button onclick="keyInsert('a')" class="key-btn col-span-1 bg-slate-800 hover:bg-slate-700 text-emerald-300 p-2 rounded-lg text-xs font-bold border border-slate-700">a</button>
        <button onclick="keyInsert('b')" class="key-btn col-span-1 bg-slate-800 hover:bg-slate-700 text-emerald-300 p-2 rounded-lg text-xs font-bold border border-slate-700">b</button>
        <button onclick="keyInsert('m')" class="key-btn col-span-1 bg-slate-800 hover:bg-slate-700 text-purple-300 p-2 rounded-lg text-xs font-bold border border-slate-700">m</button>
        <button onclick="keyInsert('n')" class="key-btn col-span-1 bg-slate-800 hover:bg-slate-700 text-purple-300 p-2 rounded-lg text-xs font-bold border border-slate-700">n</button>
        <button onclick="keyInsert('p')" class="key-btn col-span-1 bg-slate-800 hover:bg-slate-700 text-sky-300 p-2 rounded-lg text-xs font-bold border border-slate-700">p</button>
        <button onclick="keyInsert('q')" class="key-btn col-span-1 bg-slate-800 hover:bg-slate-700 text-sky-300 p-2 rounded-lg text-xs font-bold border border-slate-700">q</button>
        <button onclick="keyInsert('u')" class="key-btn col-span-1 bg-slate-800 hover:bg-slate-700 text-pink-300 p-2 rounded-lg text-xs font-bold border border-slate-700">u</button>
        <button onclick="keyInsert('v')" class="key-btn col-span-1 bg-slate-800 hover:bg-slate-700 text-pink-300 p-2 rounded-lg text-xs font-bold border border-slate-700">v</button>
        <button onclick="keyInsert('k')" class="key-btn col-span-1 bg-slate-800 hover:bg-slate-700 text-pink-300 p-2 rounded-lg text-xs font-bold border border-slate-700">k</button>
        <button onclick="keyInsert('c')" class="key-btn col-span-1 bg-slate-800 hover:bg-slate-700 text-teal-300 p-2 rounded-lg text-xs font-bold border border-slate-700">c</button>

        <!-- Row 3: Numbers & Operations -->
        <button onclick="keyInsert('1')" class="key-btn col-span-1 bg-slate-800/80 hover:bg-slate-700 text-slate-100 p-2 rounded-lg text-xs font-bold border border-slate-700">1</button>
        <button onclick="keyInsert('2')" class="key-btn col-span-1 bg-slate-800/80 hover:bg-slate-700 text-slate-100 p-2 rounded-lg text-xs font-bold border border-slate-700">2</button>
        <button onclick="keyInsert('3')" class="key-btn col-span-1 bg-slate-800/80 hover:bg-slate-700 text-slate-100 p-2 rounded-lg text-xs font-bold border border-slate-700">3</button>
        <button onclick="keyInsert('4')" class="key-btn col-span-1 bg-slate-800/80 hover:bg-slate-700 text-slate-100 p-2 rounded-lg text-xs font-bold border border-slate-700">4</button>
        <button onclick="keyInsert('5')" class="key-btn col-span-1 bg-slate-800/80 hover:bg-slate-700 text-slate-100 p-2 rounded-lg text-xs font-bold border border-slate-700">5</button>
        <button onclick="keyInsert('6')" class="key-btn col-span-1 bg-slate-800/80 hover:bg-slate-700 text-slate-100 p-2 rounded-lg text-xs font-bold border border-slate-700">6</button>
        <button onclick="keyInsert('7')" class="key-btn col-span-1 bg-slate-800/80 hover:bg-slate-700 text-slate-100 p-2 rounded-lg text-xs font-bold border border-slate-700">7</button>
        <button onclick="keyInsert('8')" class="key-btn col-span-1 bg-slate-800/80 hover:bg-slate-700 text-slate-100 p-2 rounded-lg text-xs font-bold border border-slate-700">8</button>
        <button onclick="keyInsert('9')" class="key-btn col-span-1 bg-slate-800/80 hover:bg-slate-700 text-slate-100 p-2 rounded-lg text-xs font-bold border border-slate-700">9</button>
        <button onclick="keyInsert('0')" class="key-btn col-span-1 bg-slate-800/80 hover:bg-slate-700 text-slate-100 p-2 rounded-lg text-xs font-bold border border-slate-700">0</button>
        <button onclick="keyInsert('+')" class="key-btn col-span-1 bg-slate-800 hover:bg-slate-700 text-indigo-300 p-2 rounded-lg text-xs font-bold border border-slate-700">+</button>
        <button onclick="keyInsert('-')" class="key-btn col-span-1 bg-slate-800 hover:bg-slate-700 text-indigo-300 p-2 rounded-lg text-xs font-bold border border-slate-700">-</button>

        <!-- Row 4: Additional Navigation Actions -->
        <button onclick="keyInsert(' ')" class="key-btn col-span-4 bg-slate-800 hover:bg-slate-700 text-slate-300 p-2 rounded-lg text-xs font-bold border border-slate-700"><i class="fa-solid fa-ruler-horizontal mr-1"></i> Space</button>
        <button onclick="keyNextQuestion()" class="key-btn col-span-8 bg-indigo-900/60 hover:bg-indigo-600 text-indigo-200 hover:text-white p-2 rounded-lg text-xs font-bold border border-indigo-700/60"><i class="fa-solid fa-arrow-down mr-1"></i> Next Question</button>
      </div>
    </div>
  </div>

  <!-- ================= PASSWORD PROMPT MODAL ================= -->
  <div id="passwordModal" class="no-print fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-4 hidden">
    <div class="bg-slate-900 border border-slate-700 rounded-3xl max-w-sm w-full p-6 shadow-2xl relative">
      <button onclick="closePasswordModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white text-lg"><i class="fa-solid fa-xmark"></i></button>

      <div class="text-center mb-5">
        <div class="w-12 h-12 bg-amber-500/10 text-amber-400 rounded-2xl border border-amber-500/20 flex items-center justify-center mx-auto mb-3 text-xl">
          <i class="fa-solid fa-key"></i>
        </div>
        <h2 class="text-lg font-bold text-slate-100">Unlock Target Solutions</h2>
        <p class="text-xs text-slate-400 mt-1">Teacher authentication required to view target answers.</p>
      </div>

      <form onsubmit="verifyPassword(event)" class="space-y-4 text-xs">
        <div>
          <label class="block text-slate-300 font-medium mb-1.5">Enter Teacher Password</label>
          <input type="password" id="passwordInput" required placeholder="Enter password..." class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3.5 py-2.5 text-slate-100 focus:outline-none focus:border-indigo-500 font-mono">
        </div>

        <div id="passwordError" class="hidden text-rose-400 text-xs bg-rose-950/40 border border-rose-800/50 p-2.5 rounded-xl flex items-center gap-2">
          <i class="fa-solid fa-circle-exclamation"></i>
          <span>Incorrect Password. Access Denied.</span>
        </div>

        <button type="submit" class="w-full py-2.5 bg-gradient-to-r from-amber-600 to-amber-500 hover:from-amber-500 hover:to-amber-400 text-slate-950 font-bold rounded-xl shadow-lg shadow-amber-500/20 transition">
          Unlock Solutions
        </button>
      </form>
    </div>
  </div>

  <!-- ================= SUBMISSION STUDENT DETAILS MODAL ================= -->
  <div id="submitModal" class="no-print fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-4 hidden">
    <div class="bg-slate-900 border border-slate-700 rounded-3xl max-w-lg w-full p-6 shadow-2xl relative">
      <button onclick="closeSubmitModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white text-lg"><i class="fa-solid fa-xmark"></i></button>

      <div class="text-center mb-6">
        <div class="w-12 h-12 bg-indigo-500/10 text-indigo-400 rounded-2xl border border-indigo-500/20 flex items-center justify-center mx-auto mb-3 text-xl">
          <i class="fa-solid fa-graduation-cap"></i>
        </div>
        <h2 class="text-xl font-bold text-slate-100">Submit Practice Worksheet</h2>
        <p class="text-xs text-slate-400 mt-1">Please enter your details to generate your official performance report & certificate.</p>
      </div>

      <form onsubmit="generateFinalReport(event)" class="space-y-4 text-xs">
        <div>
          <label class="block text-slate-300 font-medium mb-1">Full Student Name <span class="text-rose-400">*</span></label>
          <input type="text" id="studentName" required placeholder="e.g. Alex Wong" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3.5 py-2.5 text-slate-100 focus:outline-none focus:border-indigo-500">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-300 font-medium mb-1">Class <span class="text-rose-400">*</span></label>
            <input type="text" id="studentClass" required placeholder="e.g. 3A" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3.5 py-2.5 text-slate-100 focus:outline-none focus:border-indigo-500">
          </div>
          <div>
            <label class="block text-slate-300 font-medium mb-1">Class Number <span class="text-rose-400">*</span></label>
            <input type="number" id="studentClassNum" required placeholder="e.g. 15" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3.5 py-2.5 text-slate-100 focus:outline-none focus:border-indigo-500">
          </div>
        </div>

        <div>
          <label class="block text-slate-300 font-medium mb-1">Submission Date</label>
          <input type="date" id="submissionDate" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3.5 py-2.5 text-slate-100 focus:outline-none focus:border-indigo-500">
        </div>

        <div class="bg-indigo-950/40 border border-indigo-800/50 rounded-2xl p-3 flex items-center justify-between text-indigo-300">
          <span>Completed Questions:</span>
          <span id="modalAnsweredCount" class="font-bold text-white">0 / 55</span>
        </div>

        <button type="submit" class="w-full py-3 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white font-bold rounded-xl shadow-lg shadow-indigo-600/30 transition">
          Generate Official Report & Certificate
        </button>
      </form>
    </div>
  </div>

  <!-- ================= FINAL REPORT / CERTIFICATE VIEW ================= -->
  <div id="reportPage" class="hidden min-h-screen bg-slate-900 text-slate-100 p-4 sm:p-8">
    <div class="max-w-5xl mx-auto">
      
      <!-- Report Header / Actions Bar -->
      <div class="no-print flex items-center justify-between bg-slate-800 p-4 rounded-2xl mb-6 border border-slate-700">
        <button onclick="closeReportPage()" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-xs font-semibold rounded-xl text-slate-200 transition">
          <i class="fa-solid fa-arrow-left mr-1"></i> Return to Worksheet
        </button>
        <div class="flex items-center gap-3">
          <button onclick="window.print()" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold rounded-xl shadow-lg transition">
            <i class="fa-solid fa-print mr-1"></i> Print / Save as PDF
          </button>
        </div>
      </div>

      <!-- Printable Report Container -->
      <div class="card-box bg-slate-800/80 border border-slate-700 rounded-3xl p-6 sm:p-10 shadow-2xl relative overflow-hidden">
        
        <!-- School Header -->
        <div class="text-center border-b border-slate-700 pb-6 mb-6">
