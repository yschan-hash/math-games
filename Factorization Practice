              id="input-${q.id}" 
              value="${escapeHtml(userVal)}" 
              onfocus="setActiveInput(${q.id})"
              oninput="handleInputChange(${q.id}, this.value)"
              placeholder="e.g. (x - 2)(x + 3)" 
              class="w-full bg-slate-900 border ${status === 'correct' ? 'border-emerald-500' : status === 'incorrect' ? 'border-rose-500' : 'border-slate-700 focus:border-indigo-500'} rounded-xl px-3.5 py-2 text-sm text-slate-100 font-mono focus:outline-none transition"
            />
          </div>
        `;

        container.appendChild(card);

        // Render KaTeX for Question
        setTimeout(() => {
          renderKaTeX(`katex-expr-${q.id}`, q.exprTex);
          renderKaTeX(`katex-target-${q.id}`, q.targetTex);
        }, 10);
      });
    }

    window.setActiveInput = function(qId) {
      activeInputId = qId;
      const targetLabel = document.getElementById('activeQuestionTarget');
      if (targetLabel) {
        targetLabel.innerText = `Editing Q#${questionsData.find(q => q.id === qId)?.displayNum || qId}`;
      }
    };

    function normalizeAns(str) {
      if (!str) return '';
      return str
        .toLowerCase()
        .replace(/\s+/g, '')
        .replace(/\*\*/g, '^')
        .replace(/\*/g, '');
    }

    function parseMonomialFactors(monoStr) {
      if (!monoStr) return [];
      let factors = [];
      let s = monoStr;
      
      if (s.startsWith('-')) {
        factors.push('-');
        s = s.slice(1);
      } else if (s.startsWith('+')) {
        s = s.slice(1);
      }
      
      if (!s) return factors;
      
      let numMatch = s.match(/^(\d+)/);
      if (numMatch) {
        factors.push(numMatch[1]);
        s = s.slice(numMatch[1].length);
      }
      
      if (s) {
        let varMatches = s.match(/([a-z](\^\d+)?)/g);
        if (varMatches) {
          factors.push(...varMatches);
        } else {
          factors.push(s);
        }
      }
      
      return factors;
    }

    function canonicalizePolynomial(polyStr) {
      if (!polyStr) return '';
      let terms = [];
      let current = '';
      for (let i = 0; i < polyStr.length; i++) {
        let ch = polyStr[i];
        if ((ch === '+' || ch === '-') && i > 0 && polyStr[i-1] !== '^' && polyStr[i-1] !== '(') {
          if (current) terms.push(current);
          current = ch;
        } else {
          current += ch;
        }
      }
      if (current) terms.push(current);
      
      terms = terms.map(t => t.startsWith('+') ? t.slice(1) : t);
      
      terms.sort((a, b) => {
        let aHasVar = /[a-z]/.test(a);
        let bHasVar = /[a-z]/.test(b);
        if (aHasVar && !bHasVar) return -1;
        if (!aHasVar && bHasVar) return 1;
        return a.localeCompare(b);
      });
      
      return terms.join('+').replace(/\+-/g, '-');
    }

    function canonicalizeExpression(str) {
      if (!str) return '';
      
      let s = str.toLowerCase().replace(/\s+/g, '');
      s = s.replace(/\*\*/g, '^');
      
      // Expand factor powers: (expr)^2 -> (expr)(expr), (expr)^3 -> (expr)(expr)(expr)
      s = s.replace(/(\([^)]+\))\^2/g, '$1$1');
      s = s.replace(/(\([^)]+\))\^3/g, '$1$1$1');
      
      // Extract bracketed factors
      let bracketedFactors = [];
      let remaining = s.replace(/\(([^)]+)\)/g, (match, inner) => {
        let canonInner = canonicalizePolynomial(inner);
        bracketedFactors.push(`(${canonInner})`);
        return '';
      });
      
      remaining = remaining.replace(/\*/g, '');
      let monomialFactors = parseMonomialFactors(remaining);
      
      let allFactors = [...monomialFactors, ...bracketedFactors];
      allFactors.sort();
      
      return allFactors.join('*');
    }

    function isAnswerCorrect(userVal, question) {
      if (!userVal || userVal.trim() === '') return false;
      
      const normUser = normalizeAns(userVal);
      const canonUser = canonicalizeExpression(userVal);
      
      for (let acc of question.accepted) {
        const normAcc = normalizeAns(acc);
        if (normUser === normAcc) return true;
        
        const canonAcc = canonicalizeExpression(acc);
        if (canonUser && canonAcc && canonUser === canonAcc) return true;
      }
      
      return false;
    }

    window.handleInputChange = function(qId, val) {
      userAnswers[qId] = val;
      const question = questionsData.find(q => q.id === qId);
      if (!question) return;

      if (!val || val.trim() === '') {
        checkStatus[qId] = 'unattempted';
      } else {
        const isCorrect = isAnswerCorrect(val, question);
        checkStatus[qId] = isCorrect ? 'correct' : 'incorrect';
      }

      saveLocalStorage();
      updateDashboard();
      updateCardStatusUI(qId);
    };

    function updateCardStatusUI(qId) {
      const status = checkStatus[qId] || 'unattempted';
      const inputEl = document.getElementById(`input-${qId}`);
      if (inputEl) {
        inputEl.className = `w-full bg-slate-900 border ${status === 'correct' ? 'border-emerald-500' : status === 'incorrect' ? 'border-rose-500' : 'border-slate-700 focus:border-indigo-500'} rounded-xl px-3.5 py-2 text-sm text-slate-100 font-mono focus:outline-none transition`;
      }
    }

    window.keyInsert = function(char) {
      if (!activeInputId) {
        if (questionsData.length > 0) setActiveInput(questionsData[0].id);
        else return;
      }
      const inputEl = document.getElementById(`input-${activeInputId}`);
      if (!inputEl) return;

      const start = inputEl.selectionStart || inputEl.value.length;
      const end = inputEl.selectionEnd || inputEl.value.length;
      const val = inputEl.value;

      const newVal = val.substring(0, start) + char + val.substring(end);
      inputEl.value = newVal;
      inputEl.selectionStart = inputEl.selectionEnd = start + char.length;
      inputEl.focus();

      handleInputChange(activeInputId, newVal);
    };

    window.keyBackspace = function() {
      if (!activeInputId) return;
      const inputEl = document.getElementById(`input-${activeInputId}`);
      if (!inputEl) return;

      const start = inputEl.selectionStart || inputEl.value.length;
      const end = inputEl.selectionEnd || inputEl.value.length;
      const val = inputEl.value;

      if (start === end && start > 0) {
        const newVal = val.substring(0, start - 1) + val.substring(end);
        inputEl.value = newVal;
        inputEl.selectionStart = inputEl.selectionEnd = start - 1;
      } else if (start !== end) {
        const newVal = val.substring(0, start) + val.substring(end);
        inputEl.value = newVal;
        inputEl.selectionStart = inputEl.selectionEnd = start;
      }

      inputEl.focus();
      handleInputChange(activeInputId, inputEl.value);
    };

    window.clearActiveInput = function() {
      if (!activeInputId) return;
      const inputEl = document.getElementById(`input-${activeInputId}`);
      if (!inputEl) return;
      inputEl.value = '';
      inputEl.focus();
      handleInputChange(activeInputId, '');
    };

    window.toggleVirtualKeyboard = function() {
      const keypad = document.getElementById('virtualKeypad');
      if (keypad) {
        keypadVisible = !keypadVisible;
        if (keypadVisible) {
          keypad.classList.remove('translate-y-full');
        } else {
          keypad.classList.add('translate-y-full');
        }
      }
    };

    window.keyNextQuestion = function() {
      if (!activeInputId) {
        if (questionsData.length > 0) {
          setActiveInput(questionsData[0].id);
          jumpToQuestion(questionsData[0].id);
        }
        return;
      }
      const currentIndex = questionsData.findIndex(q => q.id === activeInputId);
      if (currentIndex >= 0 && currentIndex < questionsData.length - 1) {
        const nextQ = questionsData[currentIndex + 1];
        setActiveInput(nextQ.id);
        jumpToQuestion(nextQ.id);
      }
    };

    window.openPasswordModal = function(qId = null) {
      if (qId) pendingSolutionQId = qId;
      document.getElementById('passwordInput').value = '';
      document.getElementById('passwordError').classList.add('hidden');
      document.getElementById('passwordModal').classList.remove('hidden');
      setTimeout(() => {
        const pwdInput = document.getElementById('passwordInput');
        if (pwdInput) pwdInput.focus();
      }, 100);
    };

    window.closePasswordModal = function() {
      document.getElementById('passwordModal').classList.add('hidden');
      pendingSolutionQId = null;
    };

    window.verifyPassword = function(event) {
      event.preventDefault();
      const inputPwd = document.getElementById('passwordInput').value.trim();
      const errorEl = document.getElementById('passwordError');

      if (inputPwd === 'math2627') {
        isTeacherUnlocked = true;
        closePasswordModal();
        updateTeacherUI();
        
        // Reveal solutions across cards
        renderQuestions();

        if (pendingSolutionQId) {
          const solBox = document.getElementById(`solutionBox-${pendingSolutionQId}`);
          if (solBox) solBox.classList.remove('hidden');
          pendingSolutionQId = null;
        }
      } else {
        errorEl.classList.remove('hidden');
      }
    };

    function updateTeacherUI() {
      const btn = document.getElementById('teacherUnlockBtn');
      if (btn) {
        btn.className = 'flex items-center gap-2 px-3 py-1.5 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-xs font-semibold';
        btn.innerHTML = `<i class="fa-solid fa-lock-open"></i> <span id="teacherBtnText" class="hidden sm:inline">Teacher Mode Unlocked</span>`;
      }
    }

    window.toggleSolution = function(qId) {
      if (!isTeacherUnlocked) {
        openPasswordModal(qId);
        return;
      }

      const solBox = document.getElementById(`solutionBox-${qId}`);
      if (solBox) {
        solBox.classList.toggle('hidden');
      }
    };

    function updateDashboard() {
      let correct = 0;
      let incorrect = 0;
      let attempted = 0;

      questionsData.forEach(q => {
        const st = checkStatus[q.id];
        if (st === 'correct') {
          correct++;
          attempted++;
        } else if (st === 'incorrect') {
          incorrect++;
          attempted++;
        }
      });

      const total = questionsData.length;
      const progressPercent = Math.round((attempted / total) * 100);
      const accuracy = attempted > 0 ? Math.round((correct / attempted) * 100) : 0;

      // Update counters
      document.getElementById('correctCount').innerText = correct;
      document.getElementById('incorrectCount').innerText = incorrect;
      document.getElementById('accuracyScore').innerText = `${accuracy}%`;
      document.getElementById('progressPercent').innerText = `${progressPercent}% (${attempted}/${total})`;

      const progressBar = document.getElementById('progressBar');
      if (progressBar) progressBar.style.width = `${progressPercent}%`;

      // Minimum Requirement Badge (at least 30 answered)
      const reqBadge = document.getElementById('requirementBadge');
      const reqText = document.getElementById('reqText');
      if (reqBadge && reqText) {
        if (attempted >= 30) {
          reqBadge.className = 'flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30';
          reqBadge.innerHTML = `<i class="fa-solid fa-circle-check"></i> <span>Requirement Met: ${attempted}/30 Answered</span>`;
        } else {
          reqBadge.className = 'flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/30';
          reqBadge.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> <span>Requirement: ${attempted}/30 Answered</span>`;
        }
      }
    }

    window.openSubmitModal = function() {
      let attempted = 0;
      questionsData.forEach(q => {
        if (checkStatus[q.id] && checkStatus[q.id] !== 'unattempted') attempted++;
      });

      document.getElementById('modalAnsweredCount').innerText = `${attempted} / 55`;
      document.getElementById('submitModal').classList.remove('hidden');
    };

    window.closeSubmitModal = function() {
      document.getElementById('submitModal').classList.add('hidden');
    };

    window.generateFinalReport = function(event) {
      event.preventDefault();
      closeSubmitModal();

      const name = document.getElementById('studentName').value.trim();
      const cls = document.getElementById('studentClass').value.trim();
      const clsNum = document.getElementById('studentClassNum').value.trim();
      const subDate = document.getElementById('submissionDate').value;

      document.getElementById('rptStudentName').innerText = name || '-';
      document.getElementById('rptStudentClass').innerText = `${cls || '-'} (${clsNum || '-'})`;
      document.getElementById('rptDate').innerText = subDate || '-';
      document.getElementById('rptTimeTaken').innerText = formatTime(timerSeconds);

      let correct = 0;
      let incorrect = 0;
      let attempted = 0;

      const tableBody = document.getElementById('rptTableBody');
      tableBody.innerHTML = '';

      questionsData.forEach(q => {
        const status = checkStatus[q.id] || 'unattempted';
        const uAns = userAnswers[q.id] || '';

        if (status === 'correct') correct++;
        if (status === 'incorrect') incorrect++;
        if (status !== 'unattempted') attempted++;

        let statusTag = `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-400">Unattempted</span>`;
        if (status === 'correct') {
          statusTag = `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-900/50 text-emerald-300 border border-emerald-700/50">Correct</span>`;
        } else if (status === 'incorrect') {
          statusTag = `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-900/50 text-rose-300 border border-rose-700/50">Incorrect</span>`;
        }

        const targetSolContent = isTeacherUnlocked 
          ? `<div id="rpt-sol-${q.id}"></div>` 
          : `<span class="text-amber-400/80 italic text-[10px] flex items-center gap-1"><i class="fa-solid fa-lock text-[9px]"></i> Protected</span>`;

        const tr = document.createElement('tr');
        tr.className = 'border-b border-slate-700/40 hover:bg-slate-800/40';
        tr.innerHTML = `
          <td class="p-3 font-bold text-indigo-400">#${q.displayNum}</td>
          <td class="p-3"><span class="px-2 py-0.5 rounded text-[10px] font-bold ${q.level === 1 ? 'bg-blue-900/50 text-blue-300' : 'bg-purple-900/50 text-purple-300'}">L${q.level}</span></td>
          <td class="p-3"><div id="rpt-q-${q.id}" class="text-slate-100"></div></td>
          <td class="p-3 font-mono ${status === 'correct' ? 'text-emerald-300' : status === 'incorrect' ? 'text-rose-300' : 'text-slate-500'}">${escapeHtml(uAns) || '-'}</td>
          <td class="p-3 font-mono text-indigo-300">${targetSolContent}</td>
          <td class="p-3 text-center">${statusTag}</td>
        `;
        tableBody.appendChild(tr);

        setTimeout(() => {
          renderKaTeX(`rpt-q-${q.id}`, q.exprTex);
          if (isTeacherUnlocked) {
            renderKaTeX(`rpt-sol-${q.id}`, q.targetTex);
          }
        }, 10);
      });

      document.getElementById('rptTotalAttempted').innerText = `${attempted} / 55`;
      document.getElementById('rptCorrectCount').innerText = correct;
      document.getElementById('rptIncorrectCount').innerText = incorrect;

      const acc = attempted > 0 ? Math.round((correct / attempted) * 100) : 0;
      document.getElementById('rptAccuracy').innerText = `${acc}%`;

      // Show Report Screen
      document.getElementById('reportPage').classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    window.closeReportPage = function() {
      document.getElementById('reportPage').classList.add('hidden');
    };

    function saveLocalStorage() {
      try {
        localStorage.setItem('factorization_userAnswers', JSON.stringify(userAnswers));
        localStorage.setItem('factorization_checkStatus', JSON.stringify(checkStatus));
        localStorage.setItem('factorization_timerSeconds', timerSeconds.toString());
      } catch (e) {}
    }

    function loadLocalStorage() {
      try {
        const savedAns = localStorage.getItem('factorization_userAnswers');
        const savedStatus = localStorage.getItem('factorization_checkStatus');
        const savedTimer = localStorage.getItem('factorization_timerSeconds');

        if (savedAns) userAnswers = JSON.parse(savedAns);
        if (savedStatus) checkStatus = JSON.parse(savedStatus);
        if (savedTimer) timerSeconds = parseInt(savedTimer, 10) || 0;
      } catch (e) {}
    }

    window.confirmResetAll = function() {
      if (confirm("Are you sure you want to reset all your progress and answers? This action cannot be undone.")) {
        userAnswers = {};
        checkStatus = {};
        timerSeconds = 0;
        localStorage.clear();
        updateDashboard();
        renderQuestions();
      }
    };

    function escapeHtml(str) {
      if (!str) return '';
      return str
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }
  </script>
